---
import type { Project } from '../i18n/content/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group rounded-lg border border-border bg-surface-raised/60 hover:border-accent/30 lift hover:shadow-glow flex flex-col overflow-hidden">
  <!-- header -->
  <div class="flex items-center justify-between gap-3 px-5 sm:px-6 pt-5">
    <div class="flex items-center gap-2 min-w-0">
      <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 7a2 2 0 012-2h4l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
      </svg>
      <h3 class="text-base sm:text-lg font-display font-bold text-white truncate group-hover:text-accent transition-colors">
        {project.title}
      </h3>
    </div>
    <span class="font-mono text-xs text-neutral-600 flex-shrink-0">{project.year}</span>
  </div>

  <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-3 flex flex-col flex-1">
    <p class="font-mono text-[11px] sm:text-xs text-accent mb-3">
      {project.role} <span class="text-neutral-700">·</span> <span class="text-neutral-500">{project.organization}</span>
    </p>

    <p class="text-sm leading-relaxed text-neutral-400 mb-4">{project.description}</p>

    <!-- metrics -->
    <div class="flex flex-wrap gap-2 mb-4">
      {project.metrics.map((m) => (
        <span class="text-xs font-medium text-accent bg-accent/10 px-2.5 py-1 border border-accent/20 rounded">
          {m}
        </span>
      ))}
    </div>

    <!-- highlights -->
    <ul class="space-y-2 mb-5">
      {project.highlights.map((h) => (
        <li class="flex gap-2.5 text-sm text-neutral-500 leading-relaxed">
          <span class="text-accent flex-shrink-0 mt-0.5">›</span>
          <span>{h}</span>
        </li>
      ))}
    </ul>

    <!-- tech -->
    <div class="flex flex-wrap gap-1.5 mt-auto pt-4 border-t border-border/60">
      {project.techStack.map((tech) => (
        <span class="font-mono text-[10px] text-neutral-500 border border-border px-1.5 py-0.5 rounded">{tech}</span>
      ))}
    </div>
  </div>
</article>
