---
import { useTranslations, type Lang } from '../i18n/utils';
import { getProjects } from '../i18n/content/projects';
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = getProjects(lang);
---

<section id="projects" class="py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-6">
    <div data-animate>
      <SectionHeading
        cmd={t('section.projects.cmd')}
        title={t('section.projects.title')}
        subtitle={t('section.projects.subtitle')}
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 fade-in-stagger">
      {projects.map((project) => (
        <div data-animate>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </div>
</section>
