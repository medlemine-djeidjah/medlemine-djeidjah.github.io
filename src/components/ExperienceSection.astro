---
import { useTranslations, type Lang } from '../i18n/utils';
import { getWork } from '../i18n/content/work';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const experiences = getWork(lang);
---

<section id="experience" class="py-24 md:py-32">
  <div class="mx-auto max-w-4xl px-5 md:px-6">
    <div data-animate>
      <SectionHeading
        cmd={t('section.experience.cmd')}
        title={t('section.experience.title')}
        subtitle={t('section.experience.subtitle')}
      />
    </div>

    <div class="relative pl-7 sm:pl-9 fade-in-stagger">
      <!-- vertical line -->
      <div class="absolute left-[7px] sm:left-[9px] top-2 bottom-2 w-px bg-border"></div>

      <div class="space-y-4">
        {experiences.map((exp, i) => (
          <div class="relative" data-animate>
            <!-- node -->
            <div class="absolute -left-7 sm:-left-9 top-5 flex items-center justify-center w-[15px] h-[15px] rounded-full border border-accent/40 bg-surface">
              <span class="w-[6px] h-[6px] rounded-full bg-accent"></span>
            </div>

            <div class="exp-card group rounded-lg border border-border bg-surface-raised/60 hover:border-accent/30 transition-colors overflow-hidden">
              <button
                class="exp-toggle w-full text-left p-5 sm:p-6 cursor-pointer"
                aria-expanded="false"
                data-exp={i}
              >
                <div class="flex items-center justify-between gap-3 mb-2.5">
                  <span class="font-mono text-xs text-neutral-500">{exp.period}</span>
                  <span class="font-mono text-[10px] uppercase tracking-wider text-accent border border-accent/25 bg-accent/5 px-2 py-0.5 rounded">
                    {exp.type}
                  </span>
                </div>

                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="font-display text-lg sm:text-xl font-bold text-white leading-tight">
                      {exp.organization}
                    </h3>
                    <p class="font-mono text-sm text-accent mt-1">{exp.role}</p>
                    <p class="font-mono text-[11px] text-neutral-600 mt-0.5">{exp.location}</p>
                  </div>
                  <svg class="exp-chevron w-4 h-4 text-neutral-500 flex-shrink-0 mt-1 transition-transform group-hover:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>

                <p class="text-sm text-neutral-400 leading-relaxed mt-3">{exp.description}</p>
              </button>

              <!-- expandable details -->
              <div class="exp-details">
                <div>
                  <div class="px-5 sm:px-6 pb-6 pt-1 border-t border-border/60 mt-1">
                    <!-- responsibilities -->
                    <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-neutral-600 mt-4 mb-3">
                      <span class="text-accent">#</span> {t('exp.responsibilities')}
                    </p>
                    <ul class="space-y-2">
                      {exp.responsibilities.map((r) => (
                        <li class="flex gap-2.5 text-sm text-neutral-400 leading-relaxed">
                          <span class="text-accent flex-shrink-0 mt-0.5">›</span>
                          <span>{r}</span>
                        </li>
                      ))}
                    </ul>

                    <!-- results -->
                    <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-neutral-600 mt-5 mb-3">
                      <span class="text-accent">#</span> {t('exp.results')}
                    </p>
                    <div class="flex flex-wrap gap-2">
                      {exp.results.map((res) => (
                        <span class="text-xs text-accent bg-accent/10 border border-accent/20 px-2.5 py-1 rounded">
                          {res}
                        </span>
                      ))}
                    </div>

                    <!-- tech -->
                    <div class="flex flex-wrap gap-2 mt-5 pt-4 border-t border-border/60">
                      {exp.techStack.map((tech) => (
                        <span class="font-mono text-[11px] text-neutral-500 border border-border px-2 py-1 rounded">{tech}</span>
                      ))}
                    </div>

                    {exp.url && (
                      <a href={exp.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-5 font-mono text-xs text-neutral-500 hover:text-accent transition-colors">
                        {lang === 'en' ? 'visit' : 'visiter'} {exp.organization} <span>↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.exp-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.exp-card');
      const details = card?.querySelector('.exp-details');
      const chevron = btn.querySelector('.exp-chevron');
      const isOpen = details?.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(!!isOpen));
      chevron?.classList.toggle('rotate-180', !!isOpen);
    });
  });
</script>
