---
import { useTranslations, type Lang } from '../i18n/utils';
import { getTimeline } from '../i18n/content/experience';
import { getCertifications, getLeadership } from '../i18n/content/credentials';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const education = getTimeline(lang);
const certifications = getCertifications(lang);
const leadership = getLeadership(lang);
---

<section id="education" class="py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-6">
    <div data-animate>
      <SectionHeading cmd={t('section.education.cmd')} title={t('section.education.title')} />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      <!-- education timeline -->
      <div class="lg:col-span-7" data-animate-left>
        <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-neutral-600 mb-6">
          <span class="text-accent">//</span> {lang === 'en' ? 'formal education' : 'formation'}
        </p>

        <div class="relative pl-6 space-y-7">
          <div class="absolute left-[3px] top-2 bottom-2 w-px bg-border"></div>
          {education.map((entry) => (
            <div class="relative">
              <span class={`absolute -left-6 top-1.5 w-[9px] h-[9px] rounded-full ${entry.isActive ? 'bg-accent' : 'bg-neutral-700'}`}></span>
              <div class="flex items-center gap-2.5 mb-1">
                <span class="font-mono text-xs text-neutral-500">{entry.period}</span>
                {entry.isActive && (
                  <span class="font-mono text-[9px] uppercase tracking-wider text-accent border border-accent/30 px-1.5 py-0.5 rounded">
                    {lang === 'en' ? 'current' : 'en cours'}
                  </span>
                )}
              </div>
              <span class="font-mono text-[11px] text-accent">{entry.degree}</span>
              <h3 class="font-display text-lg font-bold text-white leading-tight mt-0.5">{entry.title}</h3>
              <p class="text-sm text-neutral-400 mt-1">{entry.institution} <span class="text-neutral-600">· {entry.location}</span></p>
              <p class="text-sm text-neutral-500 leading-relaxed mt-2">{entry.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- certifications + leadership -->
      <div class="lg:col-span-5 space-y-10" data-animate-right>
        <!-- certifications -->
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-neutral-600 mb-4">
            <span class="text-accent">//</span> {t('section.certs.title').toLowerCase()}
          </p>
          <div class="space-y-2.5">
            {certifications.map((cert) => (
              <div class="flex items-center justify-between gap-3 rounded-lg border border-border bg-surface-raised/60 px-4 py-3 hover:border-accent/30 transition-colors">
                <div class="min-w-0">
                  <span class="font-mono text-xs text-accent">{cert.issuer}</span>
                  <p class="text-sm text-neutral-300 truncate">{cert.title}</p>
                </div>
                {cert.year && <span class="font-mono text-xs text-neutral-600 flex-shrink-0">{cert.year}</span>}
              </div>
            ))}
          </div>
        </div>

        <!-- leadership -->
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-neutral-600 mb-4">
            <span class="text-accent">//</span> {t('section.leadership.title').toLowerCase()}
          </p>
          <div class="space-y-3">
            {leadership.map((role) => (
              <div class="border-l-2 border-accent/30 pl-4">
                <p class="text-sm text-white font-medium">
                  {role.role} <span class="text-neutral-600">@</span> <span class="text-accent">{role.organization}</span>
                </p>
                <p class="text-xs text-neutral-500 mt-0.5">{role.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
