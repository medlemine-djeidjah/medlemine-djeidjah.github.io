---
import { useTranslations, type Lang } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = [
  {
    slug: 'ai_ml',
    title: lang === 'en' ? 'AI & Machine Learning' : 'IA & Machine Learning',
    skills: [
      { name: 'PyTorch', color: '#EE4C2C' },
      { name: 'TensorFlow', color: '#FF6F00' },
      { name: 'scikit-learn', color: '#F7931E' },
      { name: 'CNN', color: '#FF6B00' },
      { name: 'NLP', color: '#FF8A33' },
      { name: 'OpenCV', color: '#5C3EE8' },
    ],
  },
  {
    slug: 'genai_rag',
    title: lang === 'en' ? 'Generative AI & RAG' : 'IA Generative & RAG',
    skills: [
      { name: 'LangChain', color: '#2EAD7E' },
      { name: 'Hugging Face', color: '#FFD21E' },
      { name: 'ChromaDB', color: '#FF6B00' },
      { name: 'FastAPI', color: '#009688' },
      { name: 'Embeddings', color: '#6cb6ff' },
      { name: 'RAG', color: '#FFA54F' },
    ],
  },
  {
    slug: 'data_eng',
    title: lang === 'en' ? 'Data Engineering' : 'Data Engineering',
    skills: [
      { name: 'Python', color: '#3776AB' },
      { name: 'Pandas', color: '#9B59B6' },
      { name: 'NumPy', color: '#4DABCF' },
      { name: 'SQL', color: '#e38c00' },
      { name: 'PostgreSQL', color: '#4169E1' },
      { name: 'ETL', color: '#7ec699' },
    ],
  },
  {
    slug: 'development',
    title: lang === 'en' ? 'Development' : 'Developpement',
    skills: [
      { name: 'React', color: '#61DAFB' },
      { name: 'Next.js', color: '#ffffff' },
      { name: 'TypeScript', color: '#3178C6' },
      { name: 'Flutter', color: '#02569B' },
      { name: 'Node.js', color: '#5FA04E' },
      { name: 'Express', color: '#ffffff' },
      { name: 'Django', color: '#44B78B' },
    ],
  },
  {
    slug: 'devops_cloud',
    title: lang === 'en' ? 'DevOps & Cloud' : 'DevOps & Cloud',
    skills: [
      { name: 'Docker', color: '#2496ED' },
      { name: 'Kubernetes', color: '#326CE5' },
      { name: 'AWS', color: '#FF9900' },
      { name: 'CI/CD', color: '#FF6B00' },
      { name: 'GitHub Actions', color: '#2088FF' },
      { name: 'Linux', color: '#FCC624' },
      { name: 'Nginx', color: '#009639' },
    ],
  },
];
---

<section id="skills" class="py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-6">
    <div data-animate>
      <SectionHeading cmd={t('section.skills.cmd')} title={t('section.skills.title')} />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 fade-in-stagger">
      {categories.map((cat) => (
        <div class="rounded-lg border border-border bg-surface-raised/60 p-5 lift hover:border-accent/30" data-animate>
          <div class="flex items-center gap-2 mb-4">
            <span class="text-accent font-mono text-xs">▸</span>
            <h3 class="font-mono text-xs uppercase tracking-[0.12em] text-neutral-300">{cat.title}</h3>
            <span class="ml-auto font-mono text-[10px] text-neutral-700">{cat.slug}/</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-surface-overlay/60 border border-border rounded font-mono text-[11px] text-neutral-400 hover:text-white hover:border-accent/30 transition-colors">
                <span class="w-2.5 h-2.5 rounded-sm flex-shrink-0" style={`background-color:${skill.color}`}></span>
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
