---
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const stats = [
  {
    context: lang === 'en' ? 'Ciril Groupe' : 'Ciril Groupe',
    value: 3000, prefix: '', suffix: '+',
    description: lang === 'en' ? 'clients served by the NL-to-Query assistant' : 'clients servis par l\'assistant NL-to-Query',
  },
  {
    context: 'AlloCapp',
    value: 1000, prefix: '', suffix: '+',
    description: lang === 'en' ? 'active users on the production app' : 'utilisateurs actifs en production',
  },
  {
    context: lang === 'en' ? 'ESP RAG Chatbot' : 'Chatbot RAG ESP',
    value: 70, prefix: '', suffix: '%',
    description: lang === 'en' ? 'fewer manual information queries' : 'de requetes manuelles en moins',
  },
  {
    context: 'ChronoESP',
    value: 60, prefix: '', suffix: '%',
    description: lang === 'en' ? 'less scheduling overhead via automation' : 'de charge de planification en moins',
  },
];
---

<section id="impact" class="py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-6">
    <div class="flex items-center gap-2.5 mb-10 font-mono text-xs sm:text-sm" data-animate>
      <span class="text-accent font-semibold">$</span>
      <span class="text-neutral-500">cat impact.json</span>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-border border border-border rounded-lg overflow-hidden fade-in-stagger">
      {stats.map((stat) => (
        <div class="group relative bg-surface-raised p-5 sm:p-6 hover:bg-surface-overlay transition-colors" data-animate>
          <span class="font-mono text-[10px] sm:text-xs text-neutral-600 block truncate">{stat.context}</span>
          <div class="mt-3 text-3xl sm:text-4xl md:text-5xl font-display font-extrabold text-accent tabular-nums">
            <span data-count={stat.value} data-suffix={stat.suffix} data-prefix={stat.prefix}>0</span>
          </div>
          <p class="text-xs text-neutral-500 mt-2 leading-snug">{stat.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
