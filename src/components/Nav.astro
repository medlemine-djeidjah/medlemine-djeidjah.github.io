---
import { useTranslations, type Lang } from '../i18n/utils';
import { contact } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'en' ? '/' : '/fr/';

const links = [
  { id: 'about', label: t('nav.about') },
  { id: 'skills', label: t('nav.skills') },
  { id: 'experience', label: t('nav.experience') },
  { id: 'projects', label: t('nav.projects') },
  { id: 'education', label: t('nav.timeline') },
  { id: 'contact', label: t('nav.contact') },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent">
  <nav class="mx-auto max-w-6xl px-5 md:px-6 h-14 flex items-center justify-between gap-4">
    <!-- Prompt logo -->
    <a href={base} class="font-mono text-sm font-medium text-white whitespace-nowrap hover:text-accent transition-colors">
      <span class="text-accent">~</span>/djeidjah
    </a>

    <!-- Center nav links -->
    <ul class="hidden md:flex items-center gap-1 font-mono text-xs">
      {links.map((l) => (
        <li>
          <a
            href={`#${l.id}`}
            class="px-2.5 py-1.5 text-neutral-500 hover:text-accent transition-colors"
          >
            <span class="text-neutral-700">/</span>{l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2 md:gap-3">
      <!-- CV dropdown -->
      <div class="relative" id="resume-dropdown">
        <button
          id="resume-btn"
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 font-mono text-xs text-neutral-400 hover:text-accent border border-border hover:border-accent/40 transition-all rounded"
          aria-expanded="false"
        >
          <span class="text-accent">↓</span> cv
          <svg class="w-3 h-3 transition-transform" id="resume-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="resume-menu"
          class="hidden absolute right-0 top-full mt-2 w-44 bg-surface-raised border border-border rounded overflow-hidden z-20 animate-dropdown"
        >
          <a href={contact.cvEn} target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-2.5 font-mono text-xs text-neutral-400 hover:bg-surface-overlay hover:text-white transition-colors">
            <span class="text-accent">›</span> resume_en.pdf
          </a>
          <a href={contact.cvFr} target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-2.5 font-mono text-xs text-neutral-400 hover:bg-surface-overlay hover:text-white transition-colors border-t border-border">
            <span class="text-accent">›</span> cv_fr.pdf
          </a>
        </div>
      </div>

      <!-- Social icons -->
      <div class="hidden sm:flex items-center gap-2.5">
        <a href={contact.github} target="_blank" rel="noopener noreferrer" class="text-neutral-500 hover:text-white transition-colors" aria-label="GitHub">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="text-neutral-500 hover:text-[#0A66C2] transition-colors" aria-label="LinkedIn">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>

      <!-- Language switcher -->
      <div class="flex items-center font-mono text-xs border border-border rounded overflow-hidden">
        <a href="/" class:list={['px-2.5 py-1.5 transition-colors', lang === 'en' ? 'bg-accent/15 text-accent' : 'text-neutral-600 hover:text-neutral-300']}>en</a>
        <a href="/fr/" class:list={['px-2.5 py-1.5 transition-colors border-l border-border', lang === 'fr' ? 'bg-accent/15 text-accent' : 'text-neutral-600 hover:text-neutral-300']}>fr</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const resumeBtn = document.getElementById('resume-btn');
  const resumeMenu = document.getElementById('resume-menu');
  const resumeChevron = document.getElementById('resume-chevron');
  const resumeDropdown = document.getElementById('resume-dropdown');

  resumeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = resumeMenu?.classList.toggle('hidden');
    resumeBtn.setAttribute('aria-expanded', String(!isHidden));
    resumeChevron?.classList.toggle('rotate-180');
  });

  document.addEventListener('click', (e) => {
    if (!resumeDropdown?.contains(e.target as Node)) {
      resumeMenu?.classList.add('hidden');
      resumeBtn?.setAttribute('aria-expanded', 'false');
      resumeChevron?.classList.remove('rotate-180');
    }
  });

  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) header?.classList.add('nav-scrolled');
    else header?.classList.remove('nav-scrolled');
  }, { passive: true });
</script>
