---
import { useTranslations, type Lang } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const info = [
  { label: t('meta.label.status'), value: t('meta.status') },
  { label: t('meta.label.availability'), value: t('meta.availability') },
  { label: t('meta.label.location'), value: t('meta.location') },
  { label: t('meta.label.school'), value: t('meta.school') },
  { label: t('meta.label.languages'), value: t('meta.languages') },
];

const focus = ['AI Systems', 'Data Engineering', 'Full-Stack', 'DevOps / MLOps'];
---

<section id="about" class="py-24 md:py-32 overflow-hidden">
  <div class="mx-auto max-w-6xl px-5 md:px-6">
    <div data-animate>
      <SectionHeading cmd={t('section.about.cmd')} title={t('section.about.title')} />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- prose -->
      <div class="lg:col-span-7 space-y-5 text-sm md:text-base text-neutral-400 leading-relaxed" data-animate-left>
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>

        <!-- focus tags -->
        <div class="flex flex-wrap gap-2 pt-3">
          {focus.map((f) => (
            <span class="font-mono text-xs text-accent border border-accent/25 bg-accent/5 px-3 py-1.5 rounded">
              {f}
            </span>
          ))}
        </div>
      </div>

      <!-- info card -->
      <div class="lg:col-span-5" data-animate-right>
        <div class="rounded-lg border border-border bg-surface-raised/60 overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-2.5 border-b border-border bg-surface-overlay/40">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span class="font-mono text-[11px] text-neutral-600">~/info.cfg</span>
          </div>
          <div class="p-5 font-mono text-xs sm:text-sm divide-y divide-border/60">
            {info.map((row) => (
              <div class="flex items-start justify-between gap-4 py-2.5 first:pt-0 last:pb-0">
                <span class="text-neutral-600 whitespace-nowrap">{row.label}</span>
                <span class="text-neutral-200 text-right">{row.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
