---
import { useTranslations, type Lang } from '../i18n/utils';
import { contact } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: 3000, prefix: '', suffix: '+', label: lang === 'en' ? 'clients served' : 'clients servis' },
  { value: 1000, prefix: '', suffix: '+', label: lang === 'en' ? 'production users' : 'utilisateurs prod' },
  { value: 70, prefix: '', suffix: '%', label: lang === 'en' ? 'fewer manual queries' : 'requetes en moins' },
];

const meta = [
  { key: 'status', value: t('meta.status') },
  { key: 'available', value: t('meta.availability') },
  { key: 'based_in', value: t('meta.location') },
  { key: 'languages', value: t('meta.languages') },
];
---

<section id="hero" class="relative min-h-screen flex items-center pt-24 pb-16 overflow-hidden">
  <!-- ambient glow -->
  <div class="absolute top-1/3 -left-40 w-[520px] h-[520px] glow-radial blur-2xl opacity-70 pointer-events-none"></div>
  <div class="absolute -top-20 right-0 w-[400px] h-[400px] glow-radial blur-2xl opacity-30 pointer-events-none"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-5 md:px-6 w-full">
    <!-- availability badge -->
    <div class="inline-flex items-center gap-2.5 mb-7 font-mono text-xs text-neutral-400 border border-border rounded-full pl-2.5 pr-3.5 py-1.5 bg-surface-raised/60" data-animate>
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-60"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
      </span>
      {t('hero.status.line')}
    </div>

    <!-- terminal window -->
    <div class="rounded-xl border border-border bg-surface-raised/70 backdrop-blur-sm overflow-hidden shadow-glow" data-animate-scale>
      <!-- chrome bar -->
      <div class="flex items-center gap-3 px-4 py-3 border-b border-border bg-surface-overlay/40">
        <div class="term-dots">
          <span style="background:#ff5f56"></span>
          <span style="background:#ffbd2e"></span>
          <span style="background:#FF6B00"></span>
        </div>
        <span class="font-mono text-[11px] sm:text-xs text-neutral-600 truncate">djeidjah@imt-mines-ales: ~/portfolio</span>
      </div>

      <!-- body -->
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 p-6 sm:p-8 md:p-10">
        <!-- left: identity -->
        <div class="lg:col-span-8 min-w-0">
          <div class="font-mono text-sm">
            <p class="text-white"><span class="text-accent font-semibold">$</span> whoami</p>
            <p class="mt-2 pl-3 border-l-2 border-accent/40 text-neutral-400">{t('hero.roles')}</p>
          </div>

          <h1 class="mt-7 font-display font-extrabold tracking-tight leading-[0.92] uppercase">
            <span class="block text-5xl sm:text-6xl md:text-7xl text-white">Djeidjah</span>
            <span class="block text-4xl sm:text-5xl md:text-6xl text-outline mt-1">M. Lemine</span>
          </h1>

          <p class="mt-7 text-sm md:text-base text-neutral-400 leading-relaxed max-w-xl">
            {t('hero.tagline')}
          </p>

          <p class="mt-6 font-mono text-xs sm:text-sm text-code-com">
            <span class="text-code-str">//</span> {lang === 'en' ? 'status' : 'statut'}: <span class="text-accent">running</span><span class="cursor-blink"></span>
          </p>

          <!-- CTAs -->
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#projects" class="group inline-flex items-center gap-2 px-5 py-2.5 font-mono text-xs sm:text-sm font-medium bg-accent text-black rounded hover:bg-accent-light transition-colors">
              <span class="opacity-70">$</span> {t('hero.cta.work')}
            </a>
            <a href="#contact" class="inline-flex items-center gap-2 px-5 py-2.5 font-mono text-xs sm:text-sm text-neutral-300 border border-border rounded hover:border-accent/40 hover:text-white transition-colors">
              {t('hero.cta.contact')} <span class="text-accent">→</span>
            </a>
            <a href={contact.cvEn} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 font-mono text-xs sm:text-sm text-neutral-500 hover:text-accent transition-colors">
              <span class="text-accent">↓</span> {t('hero.cta.resume')}
            </a>
          </div>
        </div>

        <!-- right: avatar + meta object -->
        <div class="lg:col-span-4">
          <div class="relative rounded-lg border border-border overflow-hidden bg-surface-overlay/40">
            <div class="flex items-center gap-2 px-3 py-2 border-b border-border">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              <span class="font-mono text-[10px] text-neutral-600">profile.png</span>
            </div>
            <div class="relative aspect-[4/5] overflow-hidden bg-accent">
              <img src="/profile.png" alt="Djeidjah Mohamed Lemine" class="w-full h-full object-cover object-top mix-blend-luminosity opacity-90" loading="eager" />
              <div class="absolute inset-0 bg-gradient-to-t from-accent/40 via-transparent to-transparent mix-blend-multiply"></div>
            </div>
          </div>

          <!-- meta object -->
          <div class="mt-4 font-mono text-[11px] sm:text-xs leading-relaxed">
            <p class="text-code-com">const me = {'{'}</p>
            {meta.map((m) => (
              <p class="pl-4 truncate">
                <span class="text-code-key">{m.key}</span><span class="text-neutral-600">:</span> <span class="text-code-str">"{m.value}"</span><span class="text-neutral-700">,</span>
              </p>
            ))}
            <p class="text-code-com">{'}'}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- stats strip -->
    <div class="mt-8 grid grid-cols-3 gap-4 sm:gap-6" data-animate>
      {stats.map((stat) => (
        <div class="border-l-2 border-accent/30 pl-4">
          <div class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold text-white tabular-nums">
            <span data-count={stat.value} data-suffix={stat.suffix} data-prefix={stat.prefix}>0</span>
          </div>
          <p class="text-[10px] sm:text-xs text-neutral-600 mt-1 font-mono">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
